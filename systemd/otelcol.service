[Unit]
Description=OpenTelemetry Collector
After=network.target

[Service]
Type=simple
Environment=COPILOT_OTEL_DATA_DIR=%h/.local/share/copilot-otel
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/copilot-otel
ExecStart=/usr/bin/otelcol-contrib --config=%h/.config/otelcol/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
